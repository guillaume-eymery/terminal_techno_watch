{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "port-tech-watch/batch.schema.json",
  "title": "Weekly port technology watch batch",
  "type": "object",
  "required": ["schema_version", "generated_at", "period", "run_notes", "articles"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "agent": { "type": "string" },
    "demo": { "type": "boolean", "description": "true for fictitious data" },
    "period": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    },
    "run_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Notes on the run: blocked sources, missing inputs, period choices"
    },
    "weekly_digest": {
      "type": "object",
      "properties": {
        "headline": { "type": "string", "maxLength": 120 },
        "editorial": { "type": "string" },
        "key_figure": {
          "type": "object",
          "properties": {
            "value": { "type": "string" },
            "caption": { "type": "string" },
            "article_id": { "type": "string" }
          }
        },
        "trends": { "type": "array", "items": { "type": "string" } },
        "must_read": { "type": "array", "items": { "type": "string" } }
      }
    },
    "articles": { "type": "array", "items": { "$ref": "#/$defs/article" } }
  },
  "$defs": {
    "article": {
      "type": "object",
      "required": ["id", "title", "published_date", "source", "link", "location", "summary", "category", "status", "criticality", "score", "criticality_rationale", "confidence", "source_access"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
        "title": { "type": "string", "maxLength": 140 },
        "published_date": { "type": "string", "format": "date" },
        "source": { "type": "string" },
        "link": { "type": "string", "pattern": "^https?://" },
        "secondary_sources": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "source_language": { "type": "string" },
        "location": {
          "type": "object",
          "required": ["terminal", "port", "city", "country", "country_code", "lat", "lon", "precision"],
          "properties": {
            "terminal": { "type": ["string", "null"] },
            "port": { "type": ["string", "null"] },
            "city": { "type": ["string", "null"] },
            "country": { "type": "string" },
            "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "unlocode": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z2-9]{3}$", "description": "UN/LOCODE of the port (e.g. ESVLC); groups articles of the same port on one map point" },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "precision": { "enum": ["terminal", "port", "city", "country", "global"] }
          }
        },
        "summary": { "type": "string", "maxLength": 600 },
        "key_points": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "terminal_impact": { "type": "string" },
        "category": {
          "enum": ["automation", "electrification", "alternative_fuels", "digital_ai", "connectivity", "cybersecurity", "equipment", "infrastructure", "safety_security", "regulation", "other"]
        },
        "technologies": { "type": "array", "items": { "type": "string" } },
        "stakeholders": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["announcement", "study", "pilot", "contract", "deployment", "operational", "incident", "discontinued"] },
        "criticality": { "enum": ["critical", "major", "watch"] },
        "score": { "type": "integer", "minimum": 1, "maximum": 100 },
        "criticality_rationale": { "type": "string" },
        "previous_link": { "type": ["string", "null"] },
        "thread_id": { "type": ["string", "null"] },
        "chaining_rationale": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_access": { "enum": ["live", "cached", "secondary"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
